# ==========================================
# NoBadFonts (nobadfonts.in) Environment Template
# ==========================================
# Duplicate this file as .env.local for local development.

# --- Core Database & Authentication (Supabase) ---
# Project URL from Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe for browser exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Service role key for admin scripts only (NEVER expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Bot Protection & Verification (Cloudflare Turnstile) ---
# Optional: Turnstile public site key for upload and auth forms
# VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# --- Search Engine Real-Time Indexing (IndexNow) ---
# Optional: IndexNow key for Bing / Yandex instant submission
INDEXNOW_KEY=your-indexnow-key-hex
INDEXNOW_KEY_LOCATION=https://nobadfonts.in/your-indexnow-key.txt

# --- AI Font Research Pipeline (Supabase Edge Function Secrets) ---
# These are set in Supabase Dashboard > Edge Functions > Secrets,
# NOT as VITE_ variables (they run server-side only).
#
# Gemini API Key. The Edge Function uses Gemini 2.5 Flash with Google Search
# grounding, so it needs no separate Custom Search or Google Fonts API key.
GEMINI_API_KEY=your-gemini-api-key
