{
  "redirects": [
    {
      "source": "/font/:path*",
      "destination": "/fonts/:path*",
      "permanent": true
    },
    {
      "source": "/catalog",
      "destination": "/fonts",
      "permanent": true
    },
    {
      "source": "/browse",
      "destination": "/fonts",
      "permanent": true
    },
    {
      "source": "/font-pairing",
      "destination": "/pairing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://bismay-exe-nobadfonts-11.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://bismay-exe-nobadfonts-11.mintlify.dev/docs/:match*"
    },
    {
      "source": "/css/:family",
      "destination": "https://wcegdxhvgwbeskaidlxr.supabase.co/functions/v1/serve-css?family=:family"
    },
    {
      "source": "/font-file/:path*",
      "destination": "https://wcegdxhvgwbeskaidlxr.supabase.co/storage/v1/object/public/fonts/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/fonts/:slug((?!.*\\.[a-zA-Z0-9]+$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebook|whatsapp|twitter|slack|discord|telegram|linkedin|applebot|pinterest|meta|embedly|quora|yahoo|duckduckgo|yandex|bing|google|Bot|Crawler|Spider|Facebook|WhatsApp|Twitter|Slack|Discord|Telegram|LinkedIn|Applebot|Pinterest).*"
        }
      ],
      "destination": "/api/og-meta?slug=:slug"
    },
    {
      "source": "/font/:slug((?!.*\\.[a-zA-Z0-9]+$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|facebook|whatsapp|twitter|slack|discord|telegram|linkedin|applebot|pinterest|meta|embedly|quora|yahoo|duckduckgo|yandex|bing|google|Bot|Crawler|Spider|Facebook|WhatsApp|Twitter|Slack|Discord|Telegram|LinkedIn|Applebot|Pinterest).*"
        }
      ],
      "destination": "/api/og-meta?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/oauth/consent",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/font-file/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(logo|banner|images)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}

